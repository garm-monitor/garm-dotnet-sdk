<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>1.1.0</Version>
    <AssemblyName>Garm.Sdk</AssemblyName>
    
    <PackageId>Garm.Monitor.Sdk</PackageId>
    <Authors>Carlos Miguel</Authors>
    <Company>Garm Monitor</Company>
    <Description>SDK Oficial para integração com o ecossistema Garm Monitor.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/garm-monitor/garm-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/garm-monitor/garm-dotnet-sdk</RepositoryUrl>
    <PackageTags>monitoring;logging;soc;cybersecurity;garm</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>